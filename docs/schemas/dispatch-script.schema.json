{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patrol.invalid/schemas/dispatch-script.schema.json",
  "title": "Dispatch script",
  "description": "One entry of content.dispatchScripts (and a stand-alone script file): timed calls for the dispatch-only mode. src/training/script.ts (parseDispatchScript) is authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "name",
    "description",
    "generator",
    "durationS",
    "steps"
  ],
  "properties": {
    "format": {
      "const": "patrol-dispatch-script"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "maxLength": 400
    },
    "generator": {
      "enum": [
        "on",
        "off"
      ]
    },
    "durationS": {
      "type": "number",
      "minimum": 60,
      "maximum": 7200
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "atS",
          "typeId",
          "near"
        ],
        "properties": {
          "atS": {
            "type": "number",
            "minimum": 0,
            "maximum": 7200
          },
          "typeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "priority": {
            "enum": [
              1,
              2,
              3,
              4,
              null
            ]
          },
          "near": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "poi"
                ],
                "properties": {
                  "poi": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "district"
                ],
                "properties": {
                  "district": {
                    "enum": [
                      "downtown",
                      "suburbs",
                      "industrial",
                      "highway",
                      "rural",
                      "campus",
                      "hospital",
                      "airport",
                      "harbor",
                      "park",
                      "water"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "z"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -3584,
                    "maximum": 3584
                  },
                  "z": {
                    "type": "number",
                    "minimum": -3584,
                    "maximum": 3584
                  }
                }
              }
            ]
          },
          "narrative": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 280
          },
          "radio": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          }
        }
      }
    }
  }
}
