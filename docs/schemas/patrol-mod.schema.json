{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patrol.invalid/schemas/patrol-mod.schema.json",
  "title": "Patrol mod bundle",
  "description": "A mod: one JSON file (or the assembled result of a folder with mod.json). Validated by src/mods/schema.ts, which is authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "name",
    "author",
    "description",
    "modVersion",
    "content"
  ],
  "properties": {
    "format": {
      "const": "patrol-mod"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,39}$",
      "description": "2..40 characters: lower-case letters, digits and hyphens."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "author": {
      "type": "string",
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "maxLength": 400
    },
    "modVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "major.minor.patch"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "callTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "call-types.schema.json"
          }
        },
        "statutes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "statute.schema.json"
          }
        },
        "rulesets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "ruleset.schema.json"
          }
        },
        "vehicles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "vehicle.schema.json"
          }
        },
        "uniforms": {
          "$ref": "uniforms.schema.json"
        },
        "districts": {
          "$ref": "districts.schema.json"
        },
        "voicePacks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "voice-pack.schema.json"
          }
        },
        "dispatchScripts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "dispatch-script.schema.json"
          }
        }
      }
    }
  }
}
