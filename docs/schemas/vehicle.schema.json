{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patrol.invalid/schemas/vehicle.schema.json",
  "title": "Vehicle model",
  "description": "One entry of content.vehicles: a full document like src/data/vehicles/*.json. Top-level structure and required sections; src/vehicles/model.ts (parseVehicleModel) checks every field.",
  "type": "object",
  "required": [
    "version",
    "id",
    "name",
    "role",
    "trafficWeight",
    "body",
    "colors",
    "lightbar",
    "mass",
    "comHeight",
    "engine",
    "drive",
    "steering",
    "suspension",
    "tires",
    "brakes",
    "fuel",
    "damage",
    "traffic"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,39}$",
      "description": "Also the file name of the model; must not exist in the base game."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "police",
        "civilian",
        "commercial",
        "service"
      ]
    },
    "trafficWeight": {
      "type": "number",
      "minimum": 0
    },
    "body": {
      "type": "object"
    },
    "colors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "hex",
          "weight"
        ],
        "properties": {
          "hex": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "lightbar": {
      "type": [
        "boolean",
        "object"
      ]
    },
    "mass": {
      "type": "number",
      "minimum": 0
    },
    "comHeight": {
      "type": "number",
      "minimum": 0
    },
    "engine": {
      "type": "object"
    },
    "drive": {
      "type": "object"
    },
    "steering": {
      "type": "object"
    },
    "suspension": {
      "type": "object"
    },
    "tires": {
      "type": "object"
    },
    "brakes": {
      "type": "object"
    },
    "fuel": {
      "type": "object"
    },
    "damage": {
      "type": "object"
    },
    "traffic": {
      "type": "object"
    },
    "equipment": {
      "type": "object"
    },
    "cargo": {
      "type": "object"
    },
    "patrol": {
      "type": "object"
    },
    "wear": {
      "type": "object"
    },
    "rider": {
      "type": "object"
    },
    "craft": {
      "type": "object"
    },
    "bike": {
      "type": "object"
    }
  }
}
