{
  "version": 1,
  "actions": [
    { "id": "knock", "label": "Knock and announce", "requires": "arrived", "sets": ["knocked"], "reveals": "inside", "once": true },
    { "id": "separateParties", "label": "Separate the parties", "requires": "arrived", "sets": ["separated"], "once": true },
    { "id": "perimeter", "label": "Set a perimeter", "requires": "arrived", "sets": ["perimeter"], "tool": "tape",
      "props": { "kind": "tape", "count": 8, "pattern": "ring", "radius": 12 }, "once": true },
    { "id": "trafficControl", "label": "Deploy cones and flares", "requires": "arrived", "sets": ["trafficControl"],
      "consumes": { "cones": 2, "flares": 2 }, "props": { "kind": "cone", "count": 4, "pattern": "line", "spacing": 4 }, "once": true },
    { "id": "preserveScene", "label": "Preserve the scene", "requires": "arrived", "sets": ["scenePreserved"], "tool": "tape",
      "props": { "kind": "tape", "count": 6, "pattern": "ring", "radius": 8 }, "once": true },
    { "id": "searchArea", "label": "Search the area", "requires": "arrived", "durationS": 20, "sets": ["areaSearched"], "reveals": "hidden" },
    { "id": "canvass", "label": "Canvass for witnesses", "requires": "arrived", "durationS": 30, "sets": ["canvassed"], "tool": "canvass", "once": true },
    { "id": "photograph", "label": "Photograph the scene", "requires": "arrived", "sets": ["photographed"], "tool": "camera", "once": true },
    { "id": "collectEvidence", "label": "Collect evidence", "requires": "photographed", "sets": ["evidenceCollected"], "tool": "evidence", "once": true },
    { "id": "evacuate", "label": "Evacuate the area", "requires": "arrived", "durationS": 30, "sets": ["evacuated"], "once": true },
    { "id": "disperseCrowd", "label": "Order the crowd to disperse", "requires": "arrived",
      "command": { "command": "disperse", "roles": ["organizer", "protester", "agitator", "bystander"] } },
    { "id": "secureAnimal", "label": "Secure the animal", "requires": "near:animal", "sets": ["animalSecured"], "once": true },
    { "id": "notifyGuardian", "label": "Notify a guardian or family member", "requires": "arrived", "durationS": 30, "sets": ["guardianNotified"], "once": true },
    { "id": "firstAid", "label": "Render first aid", "requires": "arrived", "sets": ["firstAid"], "consumes": { "firstAid": 1 }, "once": true },
    { "id": "citeVehicle", "label": "Cite the vehicle", "requires": "arrived", "sets": ["vehicleCited"], "opens": "citation" },
    { "id": "writeReport", "label": "Write the report", "requires": "arrived", "opens": "report" },
    { "id": "contain", "label": "Contain the location", "requires": "arrived", "durationS": 60, "sets": ["contained"], "once": true },
    { "id": "requestEms", "label": "Request EMS", "service": "ems", "once": true },
    { "id": "requestFire", "label": "Request the fire department", "service": "fire", "once": true },
    { "id": "requestHazmat", "label": "Request the hazmat team", "service": "hazmat", "once": true },
    { "id": "requestSwat", "label": "Request the tactical team", "service": "swat", "once": true },
    { "id": "requestK9", "label": "Request a K9 unit", "service": "k9", "once": true },
    { "id": "requestCoroner", "label": "Request the coroner", "service": "coroner", "once": true },
    { "id": "requestInterpreter", "label": "Request an interpreter", "service": "interpreter", "once": true },
    { "id": "requestAnimalControl", "label": "Request animal control", "service": "animalControl", "once": true },
    { "id": "requestBombSquad", "label": "Request the bomb squad", "service": "bombSquad", "once": true },
    { "id": "requestTow", "label": "Request a tow truck", "service": "tow", "once": true },
    { "id": "requestSupervisor", "label": "Request a supervisor", "service": "supervisor", "once": true },
    { "id": "requestDetectives", "label": "Request detectives", "service": "detectives", "once": true },
    { "id": "requestCsu", "label": "Request the crime scene unit", "service": "csu", "once": true },
    { "id": "requestNegotiator", "label": "Request a negotiator", "service": "negotiator", "once": true },
    { "id": "requestStatePatrol", "label": "Request state patrol", "service": "statePatrol", "once": true },
    { "id": "requestFederal", "label": "Request federal agents", "service": "federal", "once": true },
    { "id": "requestAirUnit", "label": "Request the air unit", "service": "airUnit", "once": true },
    { "id": "establishCommand", "label": "Establish a command post", "requires": "arrived", "sets": ["commandPost"], "once": true }
  ]
}
