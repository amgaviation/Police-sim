{
  "version": 1,
  "id": "generic",
  "name": "Generic State (default)",
  "description": "A generic US state model: broad search incident to arrest, plain-feel on frisks, implied consent after arrest, standard force and pursuit policy.",
  "rules": [
    {
      "id": "GS-1.1",
      "doctrine": "detention",
      "title": "Investigative detention",
      "cite": "Gen. Crim. Proc. § 1.1",
      "text": "An officer may briefly detain a person only when specific facts add up to reasonable suspicion of an offense."
    },
    {
      "id": "GS-2.1",
      "doctrine": "frisk",
      "title": "Frisk for weapons",
      "cite": "Gen. Crim. Proc. § 2.1",
      "text": "A pat-down of a lawfully stopped person is allowed only when the officer reasonably believes the person is armed."
    },
    {
      "id": "GS-2.2",
      "doctrine": "friskScope",
      "title": "Frisk scope",
      "cite": "Gen. Crim. Proc. § 2.2",
      "text": "A frisk is limited to weapons, plus items whose contraband nature is immediately apparent by touch."
    },
    {
      "id": "GS-3.1",
      "doctrine": "arrest",
      "title": "Arrest on probable cause",
      "cite": "Gen. Crim. Proc. § 3.1",
      "text": "An arrest requires probable cause that the person committed an arrestable offense."
    },
    {
      "id": "GS-3.2",
      "doctrine": "arrest",
      "title": "Arrest on a warrant",
      "cite": "Gen. Crim. Proc. § 3.2",
      "text": "An outstanding arrest warrant authorizes the arrest of the named person."
    },
    {
      "id": "GS-4.1",
      "doctrine": "search",
      "title": "Search incident to arrest",
      "cite": "Gen. Crim. Proc. § 4.1",
      "text": "After a lawful arrest the officer may search the arrestee within 600 seconds, or up to 60 seconds before it when probable cause already existed."
    },
    {
      "id": "GS-4.2",
      "doctrine": "search",
      "title": "Vehicle search incident to arrest",
      "cite": "Gen. Crim. Proc. § 4.2",
      "text": "A vehicle the arrestee occupied may be searched incident to a lawful arrest."
    },
    {
      "id": "GS-4.3",
      "doctrine": "search",
      "title": "Automobile exception",
      "cite": "Gen. Crim. Proc. § 4.3",
      "text": "A vehicle may be searched without a warrant when probable cause points to evidence of an offense inside it."
    },
    {
      "id": "GS-5.1",
      "doctrine": "consent",
      "title": "Consent",
      "cite": "Gen. Crim. Proc. § 5.1",
      "text": "A search is lawful when a person with authority freely and validly consents to it."
    },
    {
      "id": "GS-5.2",
      "doctrine": "consent",
      "title": "Scope of consent",
      "cite": "Gen. Crim. Proc. § 5.2",
      "text": "A consent search may not go beyond what the person agreed to."
    },
    {
      "id": "GS-5.3",
      "doctrine": "consent",
      "title": "Voluntariness of consent",
      "cite": "Gen. Crim. Proc. § 5.3",
      "text": "Consent given at gunpoint or after sustained pressure is not voluntary."
    },
    {
      "id": "GS-6.1",
      "doctrine": "exigency",
      "title": "Exigent circumstances",
      "cite": "Gen. Crim. Proc. § 6.1",
      "text": "An emergency threatening life or the loss of evidence may justify acting without a warrant or consent."
    },
    {
      "id": "GS-6.2",
      "doctrine": "entry",
      "title": "Entry into premises",
      "cite": "Gen. Crim. Proc. § 6.2",
      "text": "Officers may enter a non-public building only with consent, a warrant or exigent circumstances."
    },
    {
      "id": "GS-6.3",
      "doctrine": "search",
      "title": "Protective sweep",
      "cite": "Gen. Crim. Proc. § 6.3",
      "text": "After an arrest inside a building, officers may look in places where a person posing a danger could hide."
    },
    {
      "id": "GS-6.4",
      "doctrine": "search",
      "title": "Plain view",
      "cite": "Gen. Crim. Proc. § 6.4",
      "text": "Items in plain view are seizable only when the officer is lawfully in the place from which they are seen."
    },
    {
      "id": "GS-7.1",
      "doctrine": "miranda",
      "title": "Warnings before custodial questioning",
      "cite": "Gen. Crim. Proc. § 7.1",
      "text": "A person in custody must be warned of their rights before incriminating questions."
    },
    {
      "id": "GS-7.2",
      "doctrine": "miranda",
      "title": "Invocation of rights",
      "cite": "Gen. Crim. Proc. § 7.2",
      "text": "Once a person invokes the right to silence or counsel, questioning about the offense must stop."
    },
    {
      "id": "GS-7.3",
      "doctrine": "test",
      "title": "Breath and sobriety tests",
      "cite": "Gen. Crim. Proc. § 7.3",
      "text": "Preliminary breath and field sobriety tests require consent, which is implied after a lawful arrest."
    },
    {
      "id": "GS-8.1",
      "doctrine": "force",
      "title": "Force continuum",
      "cite": "Gen. Crim. Proc. § 8.1",
      "text": "The force used may not exceed what the subject's level of resistance justifies."
    },
    {
      "id": "GS-8.2",
      "doctrine": "force",
      "title": "Force on a restrained subject",
      "cite": "Gen. Crim. Proc. § 8.2",
      "text": "Once a subject is restrained, only minimal control force is allowed."
    },
    {
      "id": "GS-8.3",
      "doctrine": "force",
      "title": "TASER cycles",
      "cite": "Gen. Crim. Proc. § 8.3",
      "text": "A TASER may not be cycled more than 3 times against one subject."
    },
    {
      "id": "GS-8.4",
      "doctrine": "force",
      "title": "TASER risk factors",
      "cite": "Gen. Crim. Proc. § 8.4",
      "text": "A TASER should not be used on a subject with a known risk factor unless the subject poses a lethal threat."
    },
    {
      "id": "GS-8.5",
      "doctrine": "force",
      "title": "Lethal force",
      "cite": "Gen. Crim. Proc. § 8.5",
      "text": "Firearm force is justified only against a subject posing a lethal threat."
    },
    {
      "id": "GS-8.6",
      "doctrine": "force",
      "title": "Firearm display",
      "cite": "Gen. Crim. Proc. § 8.6",
      "text": "Drawing and pointing a firearm is a show of force that must be explained in the report."
    },
    {
      "id": "GS-9.1",
      "doctrine": "intervene",
      "title": "Duty to intervene",
      "cite": "Gen. Crim. Proc. § 9.1",
      "text": "An officer who sees a fellow officer use excessive force within reach must intervene."
    },
    {
      "id": "GS-10.1",
      "doctrine": "pursuit",
      "title": "Pursuit initiation",
      "cite": "Gen. Crim. Proc. § 10.1",
      "text": "A vehicle pursuit may begin only for the offenses listed in policy."
    },
    {
      "id": "GS-10.2",
      "doctrine": "pursuit",
      "title": "Pursuit termination",
      "cite": "Gen. Crim. Proc. § 10.2",
      "text": "A pursuit must be terminated when told to, or when it runs past the policy time limit."
    },
    {
      "id": "GS-10.3",
      "doctrine": "pursuit",
      "title": "Pursuit speed",
      "cite": "Gen. Crim. Proc. § 10.3",
      "text": "Pursuit speed may not stay above the allowed margin over the limit for long."
    },
    {
      "id": "GS-10.4",
      "doctrine": "pursuit",
      "title": "Pursuit equipment",
      "cite": "Gen. Crim. Proc. § 10.4",
      "text": "Emergency lights and siren must be active throughout a pursuit."
    },
    {
      "id": "GS-11.1",
      "doctrine": "recording",
      "title": "Body camera activation",
      "cite": "Gen. Crim. Proc. § 11.1",
      "text": "The body camera must be recording during enforcement contacts after a short activation grace period."
    },
    {
      "id": "GS-11.2",
      "doctrine": "recording",
      "title": "Muting the recording",
      "cite": "Gen. Crim. Proc. § 11.2",
      "text": "The recording may not be muted during an enforcement contact."
    },
    {
      "id": "GS-12.1",
      "doctrine": "evidence",
      "title": "Exclusion of evidence",
      "cite": "Gen. Crim. Proc. § 12.1",
      "text": "Evidence obtained through an unlawful act may not be used."
    },
    {
      "id": "GS-12.2",
      "doctrine": "evidence",
      "title": "Fruit of the poisonous tree",
      "cite": "Gen. Crim. Proc. § 12.2",
      "text": "Evidence derived from an earlier illegality is excluded along with it."
    },
    {
      "id": "GS-12.3",
      "doctrine": "evidence",
      "title": "Inevitable discovery",
      "cite": "Gen. Crim. Proc. § 12.3",
      "text": "Evidence that would have been found lawfully anyway remains admissible."
    }
  ],
