      "dispatcherTemplates": [
        "{unit}, respond to {randomAddress} for a medical call.",
        "{unit}, {other}, fire alarm at {randomAddress}.",
        "{unit}, copy, {time}."
      ]
    },
    "county": {
      "speakerKind": "agency",
      "units": ["County 14", "County 22", "County 31", "County 40"],
      "templates": [
        "{unit}, {code:trafficStop}, {randomPlate}, {randomAddress}.",
        "{unit}, {code:available}.",
        "{unit}, {code:registration} on {randomPlate}.",
        "{unit}, {code:onScene}."
      ],
      "dispatcherTemplates": [
        "{unit}, {code:ack}.",
