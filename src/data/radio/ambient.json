        "{unit} to {other}, you want coffee?",
        "{unit} to {other}, did you see the plate, {randomPlate}?",
        "{unit} to {other}, I'll cover you on the stop."
      ]
    },
    "fireEms": {
      "speakerKind": "agency",
      "units": ["Engine 4", "Engine 7", "Medic 2", "Medic 5", "Truck 1", "Battalion 1"],
      "templates": [
        "{unit} responding.",
        "{unit} on scene, nothing showing.",
        "{unit} available, returning to quarters.",
        "{unit} transporting one to the hospital.",
        "{unit}, patient care transferred, back in service."
