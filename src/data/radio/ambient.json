    "state": {
      "speakerKind": "agency",
      "units": ["Trooper 7", "Trooper 12", "Trooper 21"],
      "templates": [
        "{unit}, {code:trafficStop}, {randomPlate}.",
        "{unit}, {code:available}.",
        "{unit}, show me assisting a disabled vehicle at {randomAddress}."
      ],
      "dispatcherTemplates": [
        "{unit}, {code:hazard}, debris in the roadway near {randomAddress}.",
        "{unit}, {code:ack}, {time}."
      ]
    }
