{
  "version": 1,
  "channels": {
    "dispatch": {
      "speakerKind": "officer",
      "units": ["36", "34", "40", "42", "45", "51"],
      "templates": [
        "{unit}, {code:available}.",
        "{unit}, show me {code:onScene}.",
        "{unit}, {code:registration} on {randomPlate}.",
        "{unit}, {code:trafficStop}, {randomPlate}, {randomAddress}.",
        "{unit}, show me {code:busy} at {randomAddress}.",
        "{unit}, {code:enRoute} to the station."
      ],
      "dispatcherTemplates": [
        "{unit}, {code:ack}.",
        "{unit}, {randomPlate} comes back clear.",
        "{unit}, {code:alarm} at {randomAddress}, P3.",
        "{unit}, {code:hazard} reported at {randomAddress}."
      ]
    },
    "tac": {
      "speakerKind": "officer",
      "units": ["36", "34", "Sergeant 3", "K9 1"],
